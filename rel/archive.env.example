# Environment for the archive service (~/.config/archive/archive.env)

# HTTP port; the server listens on all interfaces so LAN devices can connect.
PORT=4000

# Where the database, managed yt-dlp/deno binaries and caches live.
#ARCHIVE_DATA_DIR=/home/you/.local/share/archive

# Default video storage directory (can also be changed in Settings).
#ARCHIVE_STORAGE_DIR=/home/you/Videos/Archive

# Hostname used when generating absolute URLs (optional).
#PHX_HOST=archive.local
